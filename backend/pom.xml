<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml  —  Maven build file for the ecommerce bookstore backend.

  WHAT THIS FILE DOES (in plain English):
    Tells Maven how to build our Spring Boot application: which version of
    Java to use, which libraries (dependencies) to download from the internet,
    and which plugins to run when we do `mvn spring-boot:run` or `mvn test`.

    A pom.xml is to Maven what a package.json is to Node, or a requirements.txt
    is to Python — the "shopping list" of everything the project needs.

  WHY THIS VERSION (Spring Boot 3.4.7, not the newest 4.x):
    Spring Boot 3.x is what almost every tutorial you'll consult still targets.
    3.4.x is still fully supported. Version 4.x renamed several starter
    artifacts (e.g. spring-boot-starter-web → spring-boot-starter-webmvc),
    which creates confusion when copy-pasting from tutorials. Sticking with
    3.4.7 avoids that friction. See docs/plans/feature-01-browse-catalogue-plan.md
    §2 for the full rationale.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- The version of the POM XML schema itself. Always 4.0.0 for modern Maven. -->
    <modelVersion>4.0.0</modelVersion>

    <!--
      PARENT POM
      Inheriting from spring-boot-starter-parent gives us THREE things for free:

        1. Sensible default versions for hundreds of libraries. You don't
           have to worry "which version of Jackson works with which version
           of Hibernate?" — the parent has already picked a compatible set.

        2. Preconfigured Maven plugins (compiler, surefire for tests,
           the Spring Boot Maven plugin, etc.) with sane defaults.

        3. The `mvn spring-boot:run` goal wired up so we can launch the app
           without doing anything ourselves.

      Every dependency below that doesn't specify a <version> inherits its
      version from this parent — which is why the file stays short.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.7</version>
        <!-- Empty relativePath = look up the parent from Maven Central, not
             a local folder next to this pom.xml. -->
        <relativePath/>
    </parent>

    <!--
      COORDINATES
      Every Maven project is identified by three things:
        groupId    — reverse domain name, unique per person/organisation
                     (we use com.harsh since there's no real domain yet)
        artifactId — the name of this project's jar file
        version    — SNAPSHOT means "under active development, may change"
    -->
    <groupId>com.harsh</groupId>
    <artifactId>bookstore</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>bookstore</name>
    <description>Ecommerce Bookstore Backend</description>

    <!--
      PROPERTIES
      Named values reused throughout the file. Setting java.version=21 tells
      Spring Boot's parent POM to configure the compiler and Maven Surefire
      test runner to target Java 21.
    -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <!--
      DEPENDENCIES
      Each <dependency> tells Maven to download a library from the internet
      (Maven Central by default) and put it on our classpath so we can
      `import` it in our Java code.

      Because we inherit from spring-boot-starter-parent, we don't specify
      <version> tags — the parent knows which version of each Spring library
      is compatible with Spring Boot 3.4.7.
    -->
    <dependencies>

        <!--
          spring-boot-starter-web  —  Spring MVC plus an embedded Tomcat server.
          This is what makes our app respond to HTTP requests. It also brings
          in Jackson (for turning Java objects into JSON responses).
          Every @RestController, @GetMapping, @PostMapping in our code works
          because of this one line.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          spring-boot-starter-data-jpa  —  the database layer.
          Brings in:
            * JPA (Jakarta Persistence API) — the Java standard for mapping
              a Java class to a database table (via @Entity, @Id, etc.).
            * Hibernate — the most popular implementation of that standard.
            * Spring Data JPA — magic that lets us define a repository as an
              empty interface (e.g. `interface BookRepository extends
              JpaRepository<Book, Long>`) and get the implementation
              generated for us at startup.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
          spring-boot-starter-validation  —  bean-validation annotations.
          Provides @NotNull, @Size, @Email, @Min, @Max and friends, plus
          the runtime that enforces them when we put @Valid on a controller
          parameter. Not used in FEAT-01's read-only controller, but we'll
          need it as soon as we accept a request body for write endpoints.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          spring-boot-starter-security  —  Spring Security.
          Brings in the full security filter chain, BCryptPasswordEncoder,
          UserDetailsService, AuthenticationManager, and all the annotations
          and classes needed to lock down endpoints and verify JWTs.
          Adding this dependency immediately activates Spring Security's
          auto-configuration — the app will start requiring authentication
          for all endpoints until we configure SecurityConfig in Phase 5.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
          spring-security-test  —  test helpers for Spring Security.
          Provides SecurityMockMvcRequestPostProcessors (e.g. .with(user(...)))
          used in @WebMvcTest controller tests to simulate authenticated requests.
          scope=test — only on the test classpath, never shipped in the jar.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          JJWT — build, sign, and parse JWT tokens using HMAC-SHA256.
          Split into three artifacts:
            jjwt-api     — the public API we import in our code (@compile scope)
            jjwt-impl    — the runtime implementation (runtime only — we never
                           reference its classes directly; JJWT loads it via
                           the ServiceLoader mechanism at runtime)
            jjwt-jackson — uses Jackson (already on our classpath) to handle
                           JSON serialisation inside the JWT library (runtime)
          Version 0.12.6 is the latest stable release. It uses the fluent
          builder API (Jwts.builder()...) which differs from the older 0.9.x
          API shown in many tutorials — watch out for that when reading guides.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!--
          spring-boot-devtools  —  developer conveniences during dev only.
          Watches class files on disk; when they change, restarts the app
          automatically. Also disables some caches so template/config
          changes appear immediately without a manual restart.

          scope=runtime + optional=true means: don't accidentally pull this
          into some other project that ever depends on ours.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!--
          PostgreSQL JDBC driver — connects the app to a PostgreSQL server.
          scope=runtime: our Java code never imports Postgres classes directly;
          Hibernate talks to the DB through the standard JDBC API.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          H2 in-memory database — kept in TEST scope only.
          @DataJpaTest slices (BookRepositoryTest, UserRepositoryTest, etc.)
          use H2 via application-test.properties so they remain fast and
          self-contained without a running Postgres instance.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          spring-boot-starter-test  —  everything we need to write tests.
          One dependency, six libraries inside:
            * JUnit 5      — the @Test annotation and assertions
            * Mockito      — for mocking beans in unit tests
            * AssertJ      — readable assertions like assertThat(x).isEqualTo(y)
            * Hamcrest     — matcher library (used by MockMvc)
            * JsonPath     — for asserting JSON responses in controller tests
            * Spring Test  — @DataJpaTest, @WebMvcTest, MockMvc, @SpringBootTest

          scope=test means these libraries are on the test classpath ONLY —
          not shipped in the production jar. Keeps the app slim in production.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!--
      BUILD
      How Maven should build the project.

      The spring-boot-maven-plugin does two important things:
        1. Makes `mvn spring-boot:run` work — starts the app in-place with
           a correctly-assembled classpath, no external server needed.
        2. Repackages the built jar into an executable "fat jar" — one file
           you can run with `java -jar bookstore.jar` that contains our code
           AND every dependency AND an embedded Tomcat. Useful for deploy.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
